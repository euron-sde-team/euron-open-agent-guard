{
  "name": "@euron/agentguard",
  "version": "0.1.0",
  "description": "Node.js SDK for Euron Open AgentGuard: authorize, execute and verify every action an AI agent takes.",
  "license": "MIT",
  "author": "ENGAGESPHERE TECHNOLOGY PRIVATE LIMITED and the Euron Open AgentGuard contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/euron-sde-team/euron-open-agent-guard.git",
    "directory": "sdks/node"
  },
  "keywords": ["ai-agents", "security", "authorization", "mcp", "policy", "agentguard"],
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "express": "^5.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
