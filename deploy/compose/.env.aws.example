# For `make up-aws` (compose.aws.yaml): the local containers against real AWS.
# Copy to .env.aws (git-ignored) and fill in from `terraform output` in
# infra/terraform/envs/aws-dev. Credentials come from your AWS profile, never this file.
AWS_REGION=us-east-1
# AWS_PROFILE=default
OBJECTS_BUCKET=<objects_bucket output>
AUDIT_BUCKET=<audit_bucket output>
KMS_KEY_ID=<kms_key_alias output>
# Mail through SES needs a verified identity (mail_domain) and, in the SES sandbox,
# verified recipients. Keep smtp to read every message in Mailpit instead.
MAIL_BACKEND=smtp
# MAIL_FROM_ADDRESS=<mail_from_address of the environment>
