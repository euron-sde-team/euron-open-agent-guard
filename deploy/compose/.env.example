# deploy/compose/.env: generated by `make env` (scripts/gen-local-env.sh) with random
# values. Local only, git-ignored; this file documents every variable it may hold.

# ── Secrets (random, generated) ──────────────────────────────────────────────
# Signs dashboard sessions and CSRF tokens.
SESSION_SECRET=replace-with-output-of-make-env
# Peppers the hashes of API keys, agent client secrets and invitation tokens.
TOKEN_PEPPER=replace-with-output-of-make-env
# Wraps the per-secret data keys when KEY_MODE=local (the Floci overlay uses KMS instead).
LOCAL_MASTER_KEY=replace-with-output-of-make-env
# Shared by the api, the worker and the sandbox: every sandbox run carries it.
SANDBOX_TOKEN=replace-with-output-of-make-env
# Root token of the dev-mode Vault (VAULT_TOKEN of the api and the worker).
AG_VAULT_TOKEN=replace-with-output-of-make-env

# ── Demo ─────────────────────────────────────────────────────────────────────
# The seeded demo logins (make demo); a published demo password, not a secret.
AG_DEMO_PASSWORD=Demo-Pass-2026

# ── Optional behaviour ───────────────────────────────────────────────────────
# AG_LOG_LEVEL=INFO
# Mail backend under the Floci overlay: smtp (default, Mailpit at http://localhost:5125)
# or ses (the real SES identity Terraform created on the emulator; needs a verified
# recipient per docs/guides/local-with-aws.md, and mail then does not reach Mailpit).
# AG_MAIL_BACKEND=smtp
# Host environment variables a secret of store "env" may reference (comma separated).
# AG_ENV_SECRET_ALLOWLIST=
# Commands a stdio MCP server may run inside the api container (comma separated).
# AG_STDIO_ALLOWED_COMMANDS=
# TokenShield for token and spend budgets (default: the mock on mockai).
# AG_TOKENSHIELD_URL=http://mockai:5150/tokenshield

# ── Host ports (all bound to 127.0.0.1) ──────────────────────────────────────
# AG_WEB_PORT=5110
# AG_MAILPIT_PORT=5125
# AG_SMTP_PORT=5126
# AG_EGRESS_PORT=5128
# AG_API_PORT=5130
# AG_SANDBOX_PORT=5135
# AG_PG_PORT=5142
# AG_MOCK_AI_PORT=5150
# AG_FLOCI_PORT=5166
# AG_REDIS_PORT=5179
# AG_OPA_PORT=5181
# AG_VAULT_PORT=5182
